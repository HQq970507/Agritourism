# ===== 数据库配置 =====
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_db_password
DB_DATABASE=wisdom_tree

# ===== 服务端口 =====
PORT=8080
HOST=0.0.0.0

# ===== 静态文件 =====
STATIC_FILES_PATH=./static
STATIC_FILES_PREFIX=/static
STATIC_FILES=static

# ===== 资源服务器地址前缀 =====
NEST_URL=http://127.0.0.1:8080/

# ===== 默认头像 / 树木图片 =====
DEFAULT_AVATAR=http://127.0.0.1:8080/static/mrtx.png
DEFAULT_TREE_IMG=http://127.0.0.1:8080/static/mrtree.png

# ===== JWT =====
JWT_SECRET=your_jwt_secret_change_me

# Access Token过期时间 10分钟
ACCESS_TOKEN_EXPIRES=10m
# Refresh Token过期时间 30天
REFRESH_TOKEN_EXPIRES=30d

# ===== 阿里百炼 DeepSeek =====
DASHSCOPE_API_KEY=your_dashscope_api_key

# ===== 微信小程序 =====
WX_APPID=your_wechat_appid
WX_SECRET=your_wechat_secret
